```cpp
#include <iostream>
using namespace std;
int main(){
	int m,d; cin >> m >> d;
	((m == 1 && d == 7) || (m == 3 && d == 3) || (m == 5 && d == 5) || (m == 7 && d == 7) || (m == 9 && d == 9)) ? cout << "Yes" : cout << "No";
