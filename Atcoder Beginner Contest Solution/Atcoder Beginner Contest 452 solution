### Part2 Solve 函数
1. 首先我们可以先处理好所有的 $1$
    ```cpp
    for(int i = 1;i <= m;i++){
        int sz = s[i].size();
        for(int j = 0;j < sz;j++)
            memo[sz][j][s[i][j] - 'a'];
    }
    ```
2. 然后可以对于每一个字符串来标记答案
    ```cpp
    int ok[M];
    for(int i = 1;i <= m;i++){
        int sz = s[i].size();
        if(sz != n) continue;//不满足长度条件
        bool isok = 1;
        for(int j = 0;j < sz;j++)
            if(memo[a[j]][b[j]-1][s[i][j]-'a'] == 0) isok = 0;
        if(isok) ok[i] = 1;
    }
    ```
3. 最后依据标记的答案输出即可
    ```cpp
    for(int i = 1;i <= m;i++)
         cout << (ok[i]) ? "Yes" : "No" << endl;
    ```
所以整个正解就是：
```cpp
#include <iostream>
using namespace std;
const int N = 15;
const int M = 2e5+10;
int n,m;
int a[N],b[N];
string s[M];
int memo[N][N][30];
void solve(){
    for(int i = 1;i <= m;i++){
        int sz = s[i].size();
        for(int j = 0;j < sz;j++)
            memo[sz][j][s[i][j] - 'a'] = 1;  
    }
    int ok[M];
    for(int i = 1;i <= m;i++){
        int sz = s[i].size();
        if(sz != n) continue;//不满足长度条件
        bool isok = 1;
        for(int j = 0;j < sz;j++)
            if(memo[a[j]][b[j]-1][s[i][j]-'a'] == 0) isok = 0;
        if(isok) ok[i] = 1;
    }
    for(int i = 1;i <= m;i++)
        cout << (ok[i]) ? "Yes" : "No" << endl;
}
int main(){
    cin >> n;
    for(int i = 1;i <= n;i++) cin >> a[i] >> b[i];
    cin >> m;
    for(int i = 1;i <= m;i++) cin >> s[i];
    for(int i = 1;i <= n;i++)
        for(int j = 1;j <= n;j++)
            for(int k = 0;k <= 26;k++) memo[i][j][k] = 0;
    solve();//开始操作
    return 0;
}
```
