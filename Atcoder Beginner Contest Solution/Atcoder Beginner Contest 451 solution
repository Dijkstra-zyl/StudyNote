::::success[AC代码]
```cpp
#include <iostream>
#include <queue>
#include <vector>
using namespace std;
int q;
priority_queue<int,vector<int>,greater<int>> p;
int main(){
	cin >> q;
	while(q--){
		int op,h; cin >> op >> h;
		if(op == 1) p.push(h);
		else{
			while(p.size() && p.top() <= h) p.pop();
		}
		cout << p.size() << endl;
	}
    return 0;
}
```
